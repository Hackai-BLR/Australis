{% macro valor(v) -%}
{%- set v = v | string -%}
{%- if v is match('^[A-Za-z0-9_./:@+=,%-]*$') -%}
{{ v }}
{%- else -%}
"{{ v | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') | replace('`', '\\`') }}"
{%- endif -%}
{%- endmacro -%}
{% for variable, contenido in campusia_env_valores.items() %}
{{ variable }}={{ valor(contenido) }}
{% endfor %}
