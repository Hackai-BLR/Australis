{
  "name": "@campusia/sdk",
  "version": "0.3.0",
  "description": "SDK de Campus IA para verificar la identidad y llamar a la API de la plataforma desde un curso",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js",
      "default": "./dist/hono.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.pruebas.json && node --test --experimental-strip-types --no-warnings \"pruebas/**/*.test.ts\""
  },
  "peerDependencies": {
    "hono": ">=4"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "hono": "4.13.17",
    "typescript": "5.9.3"
  }
}
