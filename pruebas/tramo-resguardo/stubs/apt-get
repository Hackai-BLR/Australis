#!/bin/bash
/usr/local/lib/sustitutos/registrar-como apt-get "$@"
if [ "$(id -u)" -ne 0 ]; then exit 100; fi
for a in "$@"; do
  if [ "$a" = install ]; then
    for b in newuidmap newgidmap slirp4netns dockerd containerd rootlesskit; do
      if [ ! -e "/usr/local/bin/$b" ]; then
        printf '#!/bin/bash\n/usr/local/lib/sustitutos/registrar-como %s "$@"\nexit 0\n' "$b" > "/usr/local/bin/$b"
        chmod 755 "/usr/local/bin/$b"
      fi
    done
  fi
done
exit 0
