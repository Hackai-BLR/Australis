[Unit]
Description=Campus IA
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=campusia
Group=campusia
WorkingDirectory=/srv/campusia
EnvironmentFile=/srv/campusia/config/campusia.env
Environment=DATABASE_URL=sqlite:///srv/campusia/datos/campusia.db
Environment=INTERFAZ_DIR=/srv/campusia/interfaz
Environment=RAIZ_CURSOS=/srv/campusia/cursos
Environment=PLANTILLA_CURSO_DIR=/srv/campusia/plataforma/plantilla-curso
Environment=SDK_DIR=/srv/campusia/plataforma/sdk
Environment=PROVEEDOR_CONTENEDORES=docker
Environment=RAIZ_ARCHIVOS=/srv/campusia/archivos
Environment=DIR_RESPALDOS=/srv/campusia/respaldos
Environment=RAIZ_ESPACIOS=/srv/campusia/espacios
ExecStart=/usr/local/bin/campusia-nucleo
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
KillMode=mixed
UMask=0027
LimitNOFILE=65536
MemoryHigh=1536M
MemoryMax=2G
ProtectSystem=strict
ReadWritePaths=/srv/campusia
ReadWritePaths=-/run/user
PrivateTmp=true
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
Alias=campusia.service
