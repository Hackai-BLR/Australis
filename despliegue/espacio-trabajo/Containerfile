FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git python3 make g++ ca-certificates tini \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@12.18.0 @anthropic-ai/claude-code@2.1.322 \
 && DISABLE_TELEMETRY=1 DISABLE_ERROR_REPORTING=1 DISABLE_AUTOUPDATER=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 claude --version \
 && npm cache clean --force \
 && rm -rf /root/.npm /root/.claude /root/.claude.json /root/.cache /root/.config /tmp/* \
 && rm -rf /usr/local/lib/node_modules/corepack /usr/local/bin/corepack /opt/yarn* /usr/local/bin/yarn /usr/local/bin/yarnpkg \
 && git config --system --add safe.directory '*'

ENV DISABLE_TELEMETRY=1 \
    DISABLE_ERROR_REPORTING=1 \
    DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    npm_config_update_notifier=false \
    npm_config_nodedir=/usr/local \
    pnpm_config_update_notifier=false \
    pnpm_config_store_dir=/tmp/campusia-pnpm-store \
    pnpm_config_cache_dir=/tmp/campusia-pnpm-cache \
    npm_config_cache=/tmp/campusia-npm-cache

COPY plantilla/ /opt/campusia/plantilla/
RUN cd /opt/campusia/plantilla \
 && node -e "const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));for(const g of ['dependencies','devDependencies','optionalDependencies']){for(const [k,v] of Object.entries(p[g]||{})){if(/^(file|link|workspace):/.test(String(v)))delete p[g][k];}}fs.writeFileSync('package.json',JSON.stringify(p,null,2));" \
 && HOME=/tmp/campusia-construccion pnpm install --config.confirmModulesPurge=false \
 && rm -rf /tmp/campusia-pnpm-store /tmp/campusia-pnpm-cache /tmp/campusia-npm-cache /tmp/campusia-construccion /root/.cache /root/.local \
 && chmod -R a+rX,go-w /opt/campusia

COPY managed-settings.json /etc/claude-code/managed-settings.json
COPY CLAUDE.md /etc/claude-code/CLAUDE.md
COPY lib/ /usr/local/lib/campusia/
COPY bin/campusia-espacio bin/campusia-agente /usr/local/bin/
RUN chown -R root:root /etc/claude-code /usr/local/lib/campusia /usr/local/bin/campusia-espacio /usr/local/bin/campusia-agente \
 && chmod 0755 /etc/claude-code /usr/local/lib/campusia \
 && chmod 0644 /etc/claude-code/managed-settings.json /etc/claude-code/CLAUDE.md /usr/local/lib/campusia/entorno.sh /usr/local/lib/campusia/agente.bashrc /usr/local/lib/campusia/sdk-fijo.mjs /usr/local/lib/campusia/sdk-ganchos.mjs \
 && chmod 0755 /usr/local/lib/campusia/vigilar-herramienta.mjs /usr/local/lib/campusia/bash /usr/local/bin/campusia-espacio /usr/local/bin/campusia-agente \
 && chmod 0711 /usr/bin/tini /usr/local/bin/node /usr/bin/bash /usr/bin/dash /usr/bin/git "$(readlink -f /usr/local/bin/claude)" "$(readlink -f /usr/local/bin/pnpm)" \
 && mkdir -p /usr/local/lib/campusia/sdk \
 && for t in /opt/campusia/plantilla/vendor/campusia-sdk-*.tgz; do if [ -f "$t" ]; then tar -xzf "$t" -C /usr/local/lib/campusia/sdk --strip-components=1 --no-same-owner || exit 1; fi; done \
 && chown -R root:root /usr/local/lib/campusia/sdk \
 && chmod -R a+rX,go-w /usr/local/lib/campusia/sdk \
 && for d in /usr/bin /usr/sbin /usr/local/bin /usr/lib/git-core /usr/libexec; do if [ -d "$d" ]; then find -L "$d" -xdev -type f -perm /111 ! -name '*.so' ! -name '*.so.*' -exec sh -c 'for f; do if [ "$(head -c 4 "$f" | od -An -tx1 | tr -d " \n")" = "7f454c46" ]; then chmod go-r "$f" || exit 1; fi; done' sh {} + || exit 1; fi; done \
 && find /usr/lib/gcc -xdev -type f \( -name cc1 -o -name cc1plus -o -name collect2 -o -name lto1 -o -name lto-wrapper \) -exec chmod go-r {} + \
 && mkdir -p /repo /datos \
 && chown node:node /repo /datos

USER node
ENV HOME=/home/node \
    PORT=3000 \
    CAMPUSIA_DATOS=/datos
WORKDIR /repo
EXPOSE 3000
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["campusia-espacio"]
