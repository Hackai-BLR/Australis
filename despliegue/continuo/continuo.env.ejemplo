CAMPUSIA_RAIZ=/srv/campusia
DESPLIEGUE_DIR=/srv/campusia/despliegue
DESPLIEGUE_ORIGEN=git@github.com:ORGANIZACION/campusia.git
DESPLIEGUE_RAMA=main
DESPLIEGUE_REPOSITORIO=ORGANIZACION/campusia
DESPLIEGUE_CLAVE=/srv/campusia/.ssh/campusia_deploy
DESPLIEGUE_PRUEBAS=bash /srv/campusia/despliegue/bin/desplegar.sh --etapa pruebas
DESPLIEGUE_COMPILAR=bash /srv/campusia/despliegue/bin/desplegar.sh --etapa compilar
DESPLIEGUE_INSTALAR=sudo -n /usr/local/sbin/campusia-instalar "$COMMIT"
DESPLIEGUE_ESPACIO=bash /srv/campusia/despliegue/bin/desplegar.sh --etapa espacio
DESPLIEGUE_SALUD=curl -fsS --max-time 5 http://127.0.0.1:8080/salud
DESPLIEGUE_SALUD_ESPERA=60
DESPLIEGUE_CPUS=1.5
DESPLIEGUE_MEMORIA=3g
DESPLIEGUE_IMAGEN=campusia-despliegue
DESPLIEGUE_CONSERVAR=3
CACHE_DIR=/srv/campusia/despliegue/cache
CACHE_MAX=4G
CACHE_MAX_DIAS=30
RECEPTOR_DIRECCION=127.0.0.1
RECEPTOR_PUERTO=9010
RECEPTOR_ENTREGAS=/srv/campusia/despliegue/entregas-vistas
DESPLIEGUE_DISPARADOR=systemctl --user start --no-block campusia-despliegue.service
