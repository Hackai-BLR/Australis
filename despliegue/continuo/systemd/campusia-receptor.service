[Unit]
Description=Receptor del webhook de despliegue de Campus IA
After=network.target

[Service]
Type=simple
EnvironmentFile=-/srv/campusia/config/continuo.env
EnvironmentFile=/srv/campusia/config/campusia.env
ExecStart=/usr/bin/python3 /srv/campusia/despliegue/bin/receptor.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
MemoryMax=128M

[Install]
WantedBy=default.target
