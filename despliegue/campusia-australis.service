[Unit]
Description=Australis (campus modules)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=campusia
Group=campusia
WorkingDirectory=/srv/campusia/australis
EnvironmentFile=/srv/campusia/config/australis.env
Environment=DATABASE_URL=sqlite:///srv/campusia/australis/datos/australis.db
Environment=UPLOAD_DIR=/srv/campusia/australis/archivos
Environment=BIND_ADDR=127.0.0.1:8090
ExecStart=/usr/local/bin/australis-server
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
UMask=0027
LimitNOFILE=65536
MemoryHigh=512M
MemoryMax=768M
ProtectSystem=strict
ReadWritePaths=/srv/campusia/australis
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
