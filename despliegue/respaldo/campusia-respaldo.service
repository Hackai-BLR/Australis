[Unit]
Description=Respaldo diario de Campus IA
After=local-fs.target

[Service]
Type=oneshot
User=campusia
Group=campusia
UMask=0077
ExecStart=/srv/campusia/plataforma/despliegue/respaldo/respaldar.sh
