# Copy to .env and adjust. Docker Compose reads .env automatically;
# when running the backend or frontend outside Docker, export these yourself.
# An empty value means "use the default" shown in the comment.

# --- backend ---
# SQLite file. In Docker it lives in the data volume; locally a relative path works.
DATABASE_URL=sqlite://australis.db
# Address the API listens on.
BIND_ADDR=0.0.0.0:8080
# Log filter (tracing EnvFilter syntax).
RUST_LOG=info,sqlx=warn

# Sessions. Default: 168 hours. Set COOKIE_SECURE=true only behind HTTPS (default false).
SESSION_TTL_HOURS=
COOKIE_SECURE=

# Uploaded files. Default directory: ./uploads (Compose uses the uploads volume instead).
# Default limit: 25 MB per upload. nginx has its own limit (client_max_body_size).
UPLOAD_DIR=
MAX_UPLOAD_MB=

# Origin of the frontend, used to build invite links.
# Default: http://localhost:5173 (dev); Compose defaults to http://localhost:3000.
APP_BASE_URL=

# First accounts, created at startup if they do not exist yet.
# SEED_ADMIN_* creates the first secretary (password: 8 characters or more).
# SEED_DEMO=true also creates fake professors and students with the same password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO=

# --- outside services: placeholders only in this build ---
# AI. The only provider is "placeholder" (scripted replies, no outside call).
AI_PROVIDER=
AI_API_KEY=
# Zoom. The only provider is "placeholder" (simulated meeting, recording and transcript).
ZOOM_PROVIDER=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- frontend (Vite dev server only) ---
# Where the dev server proxies /api.
API_URL=http://localhost:8080
